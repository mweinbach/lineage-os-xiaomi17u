  "purpose": "Stop shipping the stale SystemUIClocks-Flex prebuilt so the Google wallpaper picker's plugin discovery no longer meets a clock plugin whose @Requires target is a different ClockProviderPlugin class than the host's.",
  "root_cause": {
    "crash": "com.google.android.apps.wallpaper: com.android.systemui.shared.plugins.VersionInfo$InvalidVersionException: Missing required dependency ClockProviderPlugin",
    "host_interface": "Lcom/android/systemui/plugins/keyguard/ui/clocks/ClockProviderPlugin;",
    "flex_interface": "Lcom/android/systemui/plugins/clocks/ClockProviderPlugin;",
    "interface_package_move": {
      "project": "frameworks/base",
      "commit": "c5d2b0fd639d2aa8593881e7e1ecd7a3d7767499",
      "date": "2025-08-06",
      "subject": "Move package of LockscreenElement and related classes"
    },
    "class_loader_rule": "PluginInstance.ClassLoaderFilter delegates com.android.systemui.plugin* names to the host; a name the host lacks falls through to the plugin's own DEX, so Flex resolves its bundled copy and VersionInfo.checkVersion leaves the host's required class unmatched.",
    "systemui_behavior": "bka SystemUI's VersionCheckerImpl returns false and PluginActionManager disables the plugin; device logs also show 'Clock Id conflict on attach: DIGITAL_CLOCK_FLEX is double registered by DefaultClockProvider', because the QPR2 default provider already ships the Flex clock.",
    "wallpaper_behavior": "WallpaperPickerGoogleRelease (stallion CP1A.260505.005 snapshot) lets the exception escape from PluginInstance.onCreate on the main thread."
  },
