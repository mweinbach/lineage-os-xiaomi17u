// Exact-stock Nezha IMS provider modules, activated on 2026-09-09 from the reviewed
// templates under templates/ims (only the enabled: false lines were removed).
// Installed only when device/xiaomi/nezha/ims.mk is selected with NEZHA_IMS=true;
// the private bytes come from vendor/xiaomi/nezha-ims through its verified-input producer.
soong_namespace { imports: ["vendor/xiaomi/nezha-ims"] }

cc_prebuilt_library_shared {
    name: "nezha_ims_libimscamera_jni",
    stem: "libimscamera_jni",
    system_ext_specific: true,
    compile_multilib: "64",
    arch: { arm64: { srcs: ["//vendor/xiaomi/nezha-ims:nezha_ims_libimscamera_jni_input"] } },
    check_elf_files: true,
    allow_undefined_symbols: false,
    strip: { none: true },
    stl: "none",
    system_shared_libs: [],
    shared_libs: [
        "libnativehelper",
        "libcutils",
        "libutils",
        "liblog",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
}

