// Exact stock JNI symlinks into the app directory; they require the public native modules.
install_symlink {
    name: "nezha_ims_libimscamera_jni_app_link",
    system_ext_specific: true,
    installed_location: "priv-app/ims/lib/arm64/libimscamera_jni.so",
    symlink_target: "/system_ext/lib64/libimscamera_jni.so",
    required: ["nezha_ims_libimscamera_jni"],
}

install_symlink {
    name: "nezha_ims_libimsmedia_jni_app_link",
    system_ext_specific: true,
    installed_location: "priv-app/ims/lib/arm64/libimsmedia_jni.so",
    symlink_target: "/system_ext/lib64/libimsmedia_jni.so",
    required: ["nezha_ims_libimsmedia_jni"],
}


// Activated after the IMS API, privilege, policy and native component review.
// These are original DEX JARs, not JVM .class JARs. Preserve the already
// reviewed dex-import-uses-library.patch. No .odex/.vdex is imported.
// Product selection lives in device/xiaomi/nezha/ims.mk.

dex_import {
    name: "qti-telephony-hidl-wrapper",
    jars: ["//vendor/xiaomi/nezha-ims:nezha_ims_qti_telephony_hidl_wrapper_jar"],
    system_ext_specific: true,
    required: ["nezha_ims_qti_telephony_hidl_wrapper_xml"],
    // XML declares no transitive required libraries. Do not invent uses_libs.
}

prebuilt_etc {
    name: "nezha_ims_qti_telephony_hidl_wrapper_xml",
    src: "//vendor/xiaomi/nezha-ims:nezha_ims_qti_telephony_hidl_wrapper_xml",
    filename: "qti_telephony_hidl_wrapper.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

dex_import {
    name: "qti-telephony-utils",
    jars: ["//vendor/xiaomi/nezha-ims:nezha_ims_qti_telephony_utils_jar"],
    system_ext_specific: true,
    required: ["nezha_ims_qti_telephony_utils_xml"],
    // XML declares no transitive required libraries. Do not invent uses_libs.
}

prebuilt_etc {
    name: "nezha_ims_qti_telephony_utils_xml",
    src: "//vendor/xiaomi/nezha-ims:nezha_ims_qti_telephony_utils_xml",
    filename: "qti_telephony_utils.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

dex_import {
    name: "ims-ext-common",
    jars: ["//vendor/xiaomi/nezha-ims:nezha_ims_ims_ext_common_jar"],
    product_specific: true,
    required: ["nezha_ims_ims_ext_common_xml"],
    // XML declares no transitive required libraries. Do not invent uses_libs.
}

prebuilt_etc {
    name: "nezha_ims_ims_ext_common_xml",
    src: "//vendor/xiaomi/nezha-ims:nezha_ims_ims_ext_common_xml",
    filename: "ims_ext_common.xml",
    sub_dir: "permissions",
    product_specific: true,
}

// Public IMS application module; private bytes stay in vendor/xiaomi/nezha-ims.
// Original IMS SHA256: 56f103215b1aa301e65b6ecde29bb67318cba07f3f3d91d2196372fd14d44172
// Default candidate preserves the original verified Xiaomi-signed bytes.
// No derivative, signing key, OEM API implementation or policy is fabricated here.
// The consolidated native fragment supplies the sole public Soong namespace.

android_app_import {
    name: "ims",
    owner: "xiaomi",
    apk: "//vendor/xiaomi/nezha-ims:nezha_ims_apk_input",
    presigned: true,
    preprocessed: true,
    privileged: true,
    system_ext_specific: true,
    enforce_uses_libs: true,
    uses_libs: [
        "qti-telephony-hidl-wrapper",
        "qti-telephony-utils",
        "ims-ext-common",
    ],
    optional_uses_libs: [],
    required: [
        "nezha_ims_privapp_permissions",
        "nezha_ims_qti_permission_groups",
        "nezha_ims_libimscamera_jni_app_link",
        "nezha_ims_libimsmedia_jni_app_link",
        "nezha_ims_lib_imsvt",
    ],
}

prebuilt_etc_xml {
    name: "nezha_ims_privapp_permissions",
    src: "permissions/privapp-permissions-org.codeaurora.ims.xml",
    sub_dir: "permissions",
    filename: "privapp-permissions-org.codeaurora.ims.xml",
    system_ext_specific: true,
}

// Preserve the exact factory DIAG and AUDIO supplementary-group contract only
// after native/DAC review and target group-name resolution. No extra GIDs.
prebuilt_etc_xml {
    name: "nezha_ims_qti_permission_groups",
    src: "permissions/qti_permissions.xml",
    sub_dir: "permissions",
    filename: "qti_permissions.xml",
    system_ext_specific: true,
}
