// Private-input template. scripts/policy_inputs.py stages exact captured bytes.
// This namespace validates current source policy plus reviewed factory inputs.
// It does not install a combined policy or alter opaque vendor/ODM images.
// Original v9 framework CIL is used ONLY to classify the vendor correction.
soong_namespace {}

python_binary_host {
    name: "nezha_vendor_policy_derivation_tool",
    main: "tools/vendor_policy.py",
    srcs: ["tools/vendor_policy.py", "tools/artifact_files.py"],
}

genrule {
    name: "nezha_factory_vendor_policy",
    tools: ["nezha_vendor_policy_derivation_tool"],
    srcs: [
        "corpus/system/etc/selinux/plat_sepolicy.cil",
        "corpus/system/etc/selinux/mapping/202504.cil",
        "corpus/system_ext/etc/selinux/system_ext_sepolicy.cil",
        "corpus/system_ext/etc/selinux/mapping/202504.cil",
        "corpus/product/etc/selinux/product_sepolicy.cil",
        "corpus/product/etc/selinux/mapping/202504.cil",
        "corpus/vendor/etc/selinux/plat_pub_versioned.cil",
        "corpus/vendor/etc/selinux/vendor_sepolicy.cil",
        "corpus/odm/etc/selinux/odm_sepolicy.cil",
        "corpus/system/etc/selinux/plat_sepolicy_genfs_202504.cil",
        "tools/vendor_policy.py",
        "tools/artifact_files.py",
        "tools/vendor-policy-correction.json",
    ],
    out: ["derived/vendor_sepolicy.cil", "derived/receipt.json"],
    // Resolve the existing OUT alias before enforcing no-symlink path guards.
    // sbox precreates declared output parents, so derive into a distinct child.
    cmd: "$(location nezha_vendor_policy_derivation_tool) derive " +
         "--corpus-root $$(readlink -f $$(dirname $(location corpus/system/etc/selinux/plat_sepolicy.cil))/../../..) " +
         "--contract $$(readlink -f $(location tools/vendor-policy-correction.json)) " +
         "--tool-source $$(readlink -f $(location tools/vendor_policy.py)) " +
         "--private-output-root $$(readlink -f $(genDir)) " +
         "--output $$(readlink -f $(genDir))/candidate " +
         "&& mv $(genDir)/candidate/vendor_sepolicy.cil $(location derived/vendor_sepolicy.cil) " +
         "&& mv $(genDir)/candidate/receipt.json $(location derived/receipt.json) " +
         "&& rmdir $(genDir)/candidate",
}

// The native genfs producer has a device-architecture variant. Match pinned
// upstream precompiled_sepolicy_without_vendor_srcs when consuming it here.
filegroup {
    name: "nezha_factory_genfs_policy",
    device_first_srcs: [":plat_sepolicy_genfs_202504.cil"],
}

se_policy_binary {
    name: "nezha_factory_precompiled_sepolicy",
    srcs: [
        ":plat_sepolicy.cil",
        ":plat_mapping_file",
        ":system_ext_sepolicy.cil",
        ":system_ext_mapping_file",
        ":product_sepolicy.cil",
        ":product_mapping_file",
        "corpus/vendor/etc/selinux/plat_pub_versioned.cil",
        ":nezha_factory_vendor_policy{derived/vendor_sepolicy.cil}",
        "corpus/odm/etc/selinux/odm_sepolicy.cil",
        ":nezha_factory_genfs_policy",
    ],
    ignore_neverallow: false,
    installable: false,
    required: ["sepolicy_neverallows"],
}

// Aggregate all five partitions, including the authentic empty ODM captures.
// No fabricated entries, empty-input shortcut, or context singleton skip is used.
java_genrule {
    name: "nezha_factory_all_file_contexts",
    srcs: [
        ":plat_file_contexts",
        ":system_ext_file_contexts",
        ":product_file_contexts",
        "factory/vendor/vendor_file_contexts",
        "factory/odm/odm_file_contexts",
    ],
    out: ["combined_file_contexts"],
    cmd: "cat $(in) > $(out)",
}

file_contexts_test {
    name: "nezha_factory_file_contexts_test",
    srcs: [":nezha_factory_all_file_contexts"],
    sepolicy: ":nezha_factory_precompiled_sepolicy",
}

java_genrule {
    name: "nezha_factory_all_hwservice_contexts",
    srcs: [
        ":plat_hwservice_contexts",
        ":system_ext_hwservice_contexts",
        ":product_hwservice_contexts",
        "factory/vendor/vendor_hwservice_contexts",
        "factory/odm/odm_hwservice_contexts",
    ],
    out: ["combined_hwservice_contexts"],
    cmd: "cat $(in) > $(out)",
}

hwservice_contexts_test {
    name: "nezha_factory_hwservice_contexts_test",
    srcs: [":nezha_factory_all_hwservice_contexts"],
    sepolicy: ":nezha_factory_precompiled_sepolicy",
}

java_genrule {
    name: "nezha_factory_all_service_contexts",
    srcs: [
        ":plat_service_contexts",
        ":system_ext_service_contexts",
        ":product_service_contexts",
        "factory/vendor/vendor_service_contexts",
        "factory/odm/odm_service_contexts",
    ],
    out: ["combined_service_contexts"],
    cmd: "cat $(in) > $(out)",
}

service_contexts_test {
    name: "nezha_factory_service_contexts_test",
    srcs: [":nezha_factory_all_service_contexts"],
    sepolicy: ":nezha_factory_precompiled_sepolicy",
}

property_contexts_test {
    name: "nezha_factory_property_contexts_test",
    srcs: [
        ":plat_property_contexts",
        ":system_ext_property_contexts",
        ":product_property_contexts",
        "factory/vendor/vendor_property_contexts",
        "factory/odm/odm_property_contexts",
    ],
    sepolicy: ":nezha_factory_precompiled_sepolicy",
}

vndservice_contexts_test {
    name: "nezha_factory_vndservice_contexts_test",
    srcs: ["factory/vendor/vndservice_contexts"],
    sepolicy: ":nezha_factory_precompiled_sepolicy",
}

// checkseapp consumes real vendor/ODM entries and current framework assertions.
java_genrule {
    name: "nezha_factory_seapp_contexts_checked",
    srcs: [
        "factory/vendor/vendor_seapp_contexts",
        "factory/odm/odm_seapp_contexts",
        ":plat_seapp_neverallows",
        ":nezha_factory_precompiled_sepolicy",
    ],
    tools: ["checkseapp"],
    out: ["factory_seapp_contexts"],
    cmd: "$(location checkseapp) -p $(location :nezha_factory_precompiled_sepolicy) -c -o $(out) " +
         "$(location factory/vendor/vendor_seapp_contexts) $(location factory/odm/odm_seapp_contexts) " +
         "$(location :plat_seapp_neverallows)",
}

// The vendor-only -c prohibition cannot be used for framework coredomains.
java_genrule {
    name: "nezha_factory_platform_seapp_contexts_checked",
    srcs: [
        ":plat_seapp_contexts",
        ":system_ext_seapp_contexts",
        ":product_seapp_contexts",
        ":plat_seapp_neverallows",
        ":nezha_factory_precompiled_sepolicy",
    ],
    tools: ["checkseapp"],
    out: ["platform_seapp_contexts"],
    cmd: "$(location checkseapp) -p $(location :nezha_factory_precompiled_sepolicy) -o $(out) " +
         "$(location :plat_seapp_contexts) $(location :system_ext_seapp_contexts) " +
         "$(location :product_seapp_contexts) $(location :plat_seapp_neverallows)",
}

// Structural Treble checks run against all real context files and the combined
// binary. These do not replace full labeling checks requiring complete APK
// inventories. The device-type assertion is not in the tool's default suite.
java_genrule {
    name: "nezha_factory_sepolicy_test",
    srcs: [
        ":plat_file_contexts",
        ":system_ext_file_contexts",
        ":product_file_contexts",
        "factory/vendor/vendor_file_contexts",
        "factory/odm/odm_file_contexts",
        ":nezha_factory_precompiled_sepolicy",
    ],
    tools: ["sepolicy_tests"],
    out: ["nezha_factory_sepolicy_test.stamp"],
    cmd: "$(location sepolicy_tests) " +
         "-f $(location :plat_file_contexts) -f $(location :system_ext_file_contexts) " +
         "-f $(location :product_file_contexts) -f $(location factory/vendor/vendor_file_contexts) " +
         "-f $(location factory/odm/odm_file_contexts) " +
         "-p $(location :nezha_factory_precompiled_sepolicy) && touch $(out)",
}

java_genrule {
    name: "nezha_factory_dev_type_test",
    srcs: [
        ":plat_file_contexts",
        ":system_ext_file_contexts",
        ":product_file_contexts",
        "factory/vendor/vendor_file_contexts",
        "factory/odm/odm_file_contexts",
        ":nezha_factory_precompiled_sepolicy",
    ],
    tools: ["sepolicy_tests"],
    out: ["nezha_factory_dev_type_test.stamp"],
    cmd: "$(location sepolicy_tests) " +
         "-f $(location :plat_file_contexts) -f $(location :system_ext_file_contexts) " +
         "-f $(location :product_file_contexts) -f $(location factory/vendor/vendor_file_contexts) " +
         "-f $(location factory/odm/odm_file_contexts) " +
         "-p $(location :nezha_factory_precompiled_sepolicy) -t TestDevTypeViolations && touch $(out)",
}

// BEGIN OPTIONAL EVOLUTION POLICY BASE
// These comparison producers use the current upstream source lists and flags.
// Only the explicitly admitted Nezha source groups are excluded. Their outputs
// are never added to the ten inputs of the strict combined policy above.
filegroup {
    name: "nezha_evolution_base_public_policy",
    srcs: [":se_build_files{.system_ext_public}"],
    exclude_srcs: ["//device/xiaomi/nezha:nezha_owned_system_ext_public_policy"],
}

filegroup {
    name: "nezha_evolution_base_private_policy",
    srcs: [":se_build_files{.system_ext_private}"],
    exclude_srcs: ["//device/xiaomi/nezha:nezha_owned_system_ext_private_policy"],
}

se_policy_conf {
    name: "nezha_evolution_base_system_ext_sepolicy.conf",
    defaults: ["se_policy_conf_flags_defaults"],
    srcs: [
        ":se_build_files{.plat_public}",
        ":se_build_files{.plat_private}",
        ":nezha_evolution_base_public_policy",
        ":nezha_evolution_base_private_policy",
    ],
    system_ext_specific: true,
    installable: false,
}

se_policy_cil {
    name: "nezha_evolution_base_system_ext_sepolicy.cil",
    src: ":nezha_evolution_base_system_ext_sepolicy.conf",
    filter_out: [":plat_sepolicy.cil"],
    secilc_check: true,
    ignore_neverallow: false,
    system_ext_specific: true,
    installable: false,
}

se_policy_conf {
    name: "nezha_evolution_base_system_ext_pub_policy.conf",
    defaults: ["se_policy_conf_flags_defaults"],
    srcs: [
        ":se_build_files{.plat_public}",
        ":nezha_evolution_base_public_policy",
        ":se_build_files{.reqd_mask}",
    ],
    system_ext_specific: true,
    installable: false,
}

se_policy_cil {
    name: "nezha_evolution_base_system_ext_pub_policy.cil",
    src: ":nezha_evolution_base_system_ext_pub_policy.conf",
    filter_out: [":reqd_policy_mask.cil"],
    // Like the upstream public exporter, this is an incomplete policy subset.
    secilc_check: false,
    system_ext_specific: true,
    installable: false,
}

se_versioned_policy {
    name: "nezha_evolution_base_system_ext_mapping_file",
    base: ":nezha_evolution_base_system_ext_pub_policy.cil",
    mapping: true,
    version: "current",
    filter_out: [":plat_mapping_file"],
    system_ext_specific: true,
    installable: false,
}

filegroup {
    name: "nezha_evolution_base_property_contexts_files",
    srcs: [":property_contexts_files{.system_ext_private}"],
    exclude_srcs: ["//device/xiaomi/nezha:nezha_owned_system_ext_property_contexts"],
}

filegroup {
    name: "nezha_evolution_base_file_contexts_files",
    srcs: [":file_contexts_files{.system_ext_private}"],
    exclude_srcs: ["//device/xiaomi/nezha:nezha_owned_system_ext_file_contexts"],
}

filegroup {
    name: "nezha_evolution_base_service_contexts_files",
    srcs: [":service_contexts_files{.system_ext_private}"],
    exclude_srcs: ["//device/xiaomi/nezha:nezha_owned_system_ext_service_contexts"],
}

// Native context types declare install rules. Keep these unique comparison
// names out of PRODUCT_PACKAGES and direct build goals; only consume outputs.
property_contexts {
    name: "nezha_evolution_base_property_contexts",
    defaults: ["contexts_flags_defaults"],
    srcs: [":nezha_evolution_base_property_contexts_files"],
    system_ext_specific: true,
}

file_contexts {
    name: "nezha_evolution_base_file_contexts",
    defaults: ["contexts_flags_defaults"],
    srcs: [":nezha_evolution_base_file_contexts_files"],
    system_ext_specific: true,
}

service_contexts {
    name: "nezha_evolution_base_service_contexts",
    defaults: ["contexts_flags_defaults"],
    srcs: [":nezha_evolution_base_service_contexts_files"],
    system_ext_specific: true,
}

filegroup {
    name: "nezha_evolution_base_source_files",
    srcs: [
        ":nezha_evolution_base_public_policy",
        ":nezha_evolution_base_private_policy",
        ":nezha_evolution_base_property_contexts_files",
        ":nezha_evolution_base_file_contexts_files",
        ":nezha_evolution_base_service_contexts_files",
    ],
}
// END OPTIONAL EVOLUTION POLICY BASE
// BEGIN OPTIONAL NEZHA OEM POLICY CHECK
// Staging includes this only with an explicit reviewed OEM source contract.
// The original template is retained as provenance in both bundle profiles.
python_binary_host {
    name: "nezha_oem_policy_check_tool",
    main: "tools/oem_policy.py",
    srcs: ["tools/oem_policy.py", "tools/vendor_policy.py", "tools/artifact_files.py"],
}

java_genrule {
    name: "nezha_factory_oem_policy_check",
    tools: ["nezha_oem_policy_check_tool"],
    srcs: [
        ":plat_sepolicy.cil",
        ":plat_mapping_file",
        ":system_ext_sepolicy.cil",
        ":system_ext_mapping_file",
        ":product_sepolicy.cil",
        ":product_mapping_file",
        ":nezha_factory_genfs_policy",
        ":nezha_factory_vendor_policy{derived/vendor_sepolicy.cil}",
        "corpus/vendor/etc/selinux/plat_pub_versioned.cil",
        "corpus/vendor/etc/selinux/vendor_sepolicy.cil",
        "corpus/odm/etc/selinux/odm_sepolicy.cil",
        "tools/oem_policy.py",
        "tools/vendor_policy.py",
        "tools/artifact_files.py",
        "tools/nezha-oem-policy.json",
        "tools/nezha-init-helper-capability.json",
        // BEGIN OPTIONAL NEZHA OEM PROPERTY INPUTS
        "tools/nezha-oem-properties.json",
        ":system_ext_property_contexts",
        // END OPTIONAL NEZHA OEM PROPERTY INPUTS
        // BEGIN OPTIONAL NEZHA FRAMEWORK PROVIDER INPUTS
        "tools/framework_provider_policy.py",
        "tools/nezha-framework-provider-policy.json",
        ":system_ext_file_contexts",
        ":system_ext_service_contexts",
        "//vendor/xiaomi/nezha-framework-providers:nezha_framework_provider_inputs_check{framework-provider-inputs-checked.json}",
        // END OPTIONAL NEZHA FRAMEWORK PROVIDER INPUTS
        // BEGIN OPTIONAL EVOLUTION POLICY BASE INPUTS
        "tools/evolution_policy_base.py",
        "tools/evolution-policy-base.json",
        ":nezha_evolution_base_system_ext_sepolicy.cil",
        ":nezha_evolution_base_system_ext_mapping_file",
        ":nezha_evolution_base_system_ext_pub_policy.cil",
        ":system_ext_pub_policy.cil",
        ":nezha_evolution_base_property_contexts",
        ":nezha_evolution_base_file_contexts",
        ":nezha_evolution_base_service_contexts",
        ":nezha_evolution_base_source_files",
        // END OPTIONAL EVOLUTION POLICY BASE INPUTS
    ],
    out: ["oem-policy-native-check.json"],
    cmd: "$(location nezha_oem_policy_check_tool) check-native " +
         "--platform-cil $$(readlink -f $(location :plat_sepolicy.cil)) " +
         "--platform-mapping $$(readlink -f $(location :plat_mapping_file)) " +
         "--system-ext-cil $$(readlink -f $(location :system_ext_sepolicy.cil)) " +
         "--system-ext-mapping $$(readlink -f $(location :system_ext_mapping_file)) " +
         "--product-cil $$(readlink -f $(location :product_sepolicy.cil)) " +
         "--product-mapping $$(readlink -f $(location :product_mapping_file)) " +
         "--platform-genfs $$(readlink -f $(location :nezha_factory_genfs_policy)) " +
         "--factory-pub $$(readlink -f $(location corpus/vendor/etc/selinux/plat_pub_versioned.cil)) " +
         "--factory-vendor $$(readlink -f $(location corpus/vendor/etc/selinux/vendor_sepolicy.cil)) " +
         "--factory-odm $$(readlink -f $(location corpus/odm/etc/selinux/odm_sepolicy.cil)) " +
         "--derived-vendor $$(readlink -f $(location :nezha_factory_vendor_policy{derived/vendor_sepolicy.cil})) " +
         "--contract $$(readlink -f $(location tools/nezha-oem-policy.json)) " +
         "--capability-contract $$(readlink -f $(location tools/nezha-init-helper-capability.json)) " +
         // BEGIN OPTIONAL NEZHA OEM PROPERTY ARGUMENTS
         "--property-contract $$(readlink -f $(location tools/nezha-oem-properties.json)) " +
         "--system-ext-property-contexts $$(readlink -f $(location :system_ext_property_contexts)) " +
         // END OPTIONAL NEZHA OEM PROPERTY ARGUMENTS
         // BEGIN OPTIONAL NEZHA FRAMEWORK PROVIDER ARGUMENTS
         "--provider-contract $$(readlink -f $(location tools/nezha-framework-provider-policy.json)) " +
         "--system-ext-file-contexts $$(readlink -f $(location :system_ext_file_contexts)) " +
         "--system-ext-service-contexts $$(readlink -f $(location :system_ext_service_contexts)) " +
         // END OPTIONAL NEZHA FRAMEWORK PROVIDER ARGUMENTS
         // BEGIN OPTIONAL EVOLUTION POLICY BASE ARGUMENTS
         "--evolution-policy-base-contract $$(readlink -f $(location tools/evolution-policy-base.json)) " +
         "--evolution-base-system-ext-cil $$(readlink -f $(location :nezha_evolution_base_system_ext_sepolicy.cil)) " +
         "--evolution-base-system-ext-mapping $$(readlink -f $(location :nezha_evolution_base_system_ext_mapping_file)) " +
         "--evolution-base-public-cil $$(readlink -f $(location :nezha_evolution_base_system_ext_pub_policy.cil)) " +
         "--system-ext-public-cil $$(readlink -f $(location :system_ext_pub_policy.cil)) " +
         "--evolution-base-property-contexts $$(readlink -f $(location :nezha_evolution_base_property_contexts)) " +
         "--evolution-base-file-contexts $$(readlink -f $(location :nezha_evolution_base_file_contexts)) " +
         "--evolution-base-service-contexts $$(readlink -f $(location :nezha_evolution_base_service_contexts)) " +
         "--evolution-base-source-files $(locations :nezha_evolution_base_source_files) " +
         // END OPTIONAL EVOLUTION POLICY BASE ARGUMENTS
         "--tool-source $$(readlink -f $(location tools/oem_policy.py)) " +
         "--output $$(readlink -f $(genDir))/oem-policy-native-check.json",
}
// END OPTIONAL NEZHA OEM POLICY CHECK
