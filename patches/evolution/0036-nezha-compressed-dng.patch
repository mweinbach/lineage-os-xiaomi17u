+    /**
+     * Write factory lossless JPEG data and result metadata as a LinearRaw DNG.
+     * The caller owns the output stream. Unsupported data throws before writing.
+     * @hide
+     */
+    public synchronized void writeLossLessJpeg(OutputStream out, ByteBuffer pixels)
+            throws IOException {
+        if (out == null || pixels == null) {
+            throw new IllegalArgumentException("Null output stream or compressed RAW buffer");
+        }
+        pixels.clear();
+        nativeWriteLossLessJpeg(out, nezhaDirectBuffer(pixels), 0);
+        pixels.clear();
+    }
+
+    private static ByteBuffer nezhaDirectBuffer(ByteBuffer pixels) {
+        if (pixels.isDirect()) return pixels;
+        ByteBuffer copy = ByteBuffer.allocateDirect(pixels.capacity());
+        ByteBuffer source = pixels.duplicate();
+        source.clear();
+        copy.put(source);
+        copy.clear();
+        return copy;
+    }
+
+    private synchronized native void nativeWriteJpeg(ByteBuffer pixels, int width, int height);
