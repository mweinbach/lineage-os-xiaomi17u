+    public synchronized void writeJpeg(int width, int height, ByteBuffer pixels) {
+        if (width <= 0 || height <= 0 || pixels == null) {
+            throw new IllegalArgumentException("Invalid JPEG dimensions or buffer");
+        }
+        nativeWriteJpeg(nezhaDirectBuffer(pixels), width, height);
+        pixels.clear();
