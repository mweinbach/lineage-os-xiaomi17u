+// Hidden factory camera APIs. These methods are inert unless the Nezha camera
+// session integration is selected; regular DngCreator entry points are unchanged.
+static bool DngCreator_requireNezha(JNIEnv* env) {
+#ifdef NEZHA_COMPRESSED_DNG
+    return true;
+#else
+    jniThrowException(env, "java/lang/UnsupportedOperationException",
+            "Compressed DNG support is not selected for this product");
+    return false;
+#endif
+}
+
+static void DngCreator_nativeWriteJpeg(JNIEnv* env, jobject thiz, jobject pixels,
+        jint width, jint height) {
+    if (!DngCreator_requireNezha(env)) return;
+    NativeContext* context = DngCreator_getNativeContext(env, thiz);
+    if (!context) {
+        jniThrowException(env, "java/lang/IllegalStateException", "DngCreator is closed");
+        return;
+    }
+    const auto* data = static_cast<const uint8_t*>(env->GetDirectBufferAddress(pixels));
+    const jlong capacity = env->GetDirectBufferCapacity(pixels);
+    nezha::dng::JpegFrame frame;
+    if (width <= 0 || height <= 0 || !data || capacity <= 0 || capacity > INT32_MAX ||
+            !nezha::dng::inspectJpeg(data, static_cast<size_t>(capacity), &frame) ||
+            (frame.coding != 0xc0 && frame.coding != 0xc2) || frame.precision != 8 ||
+            frame.components != 3 ||
+            !((frame.width == static_cast<uint32_t>(width) && frame.height == static_cast<uint32_t>(height)) ||
+              (frame.width == static_cast<uint32_t>(height) && frame.height == static_cast<uint32_t>(width)))) {
+        jniThrowException(env, "java/lang/IllegalArgumentException", "Invalid compressed DNG JPEG preview");
+        return;
+    }
+    // Preserve the encoded preview, including any embedded Ultra HDR gain map and metadata.
+    Vector<uint8_t> preview;
+    if (preview.resize(static_cast<size_t>(capacity)) < 0) {
+        jniThrowException(env, "java/lang/OutOfMemoryError", "Cannot retain DNG JPEG preview");
+        return;
+    }
+    memcpy(preview.editArray(), data, static_cast<size_t>(capacity));
+    context->jpegPreview = preview;
+    context->jpegWidth = frame.width;
+    context->jpegHeight = frame.height;
+}
+
+static void DngCreator_nativeWriteLossLessJpeg(JNIEnv* env, jobject thiz, jobject outStream,
+        jobject pixels, jlong offset) {
+    if (!DngCreator_requireNezha(env)) return;
+    NativeContext* context = DngCreator_getNativeContext(env, thiz);
+    if (!context) {
+        jniThrowException(env, "java/lang/IllegalStateException", "DngCreator is closed");
+        return;
+    }
+    if (!outStream || !pixels || offset != 0) {
+        jniThrowException(env, "java/lang/IllegalArgumentException", "Invalid compressed DNG output/buffer");
+        return;
+    }
+    const auto* data = static_cast<const uint8_t*>(env->GetDirectBufferAddress(pixels));
+    const jlong capacity = env->GetDirectBufferCapacity(pixels);
+    if (!data || capacity <= 0 || capacity > INT32_MAX) {
+        jniThrowException(env, "java/lang/IllegalArgumentException", "Invalid compressed DNG direct buffer");
+        return;
+    }
+    CameraMetadata results = *context->getResult();
+    uint32_t tag = 0;
+    sp<VendorTagDescriptor> descriptor;
+    sp<VendorTagDescriptorCache> cache = VendorTagDescriptorCache::getGlobalVendorTagCache();
+    if (cache) cache->getVendorTagDescriptor(results.getVendorId(), &descriptor);
+    if (!descriptor || descriptor->lookupTag(String8("compressedParameters"),
+            String8("com.xiaomi.dng"), &tag) != OK) {
+        jniThrowException(env, "java/lang/IllegalArgumentException", "Missing compressed DNG vendor tag");
+        return;
+    }
+    camera_metadata_entry entry = results.find(tag);
+    const uint8_t* metadata = nullptr;
+    if (entry.type == TYPE_BYTE && entry.count == nezha::dng::Layout::kMetadataBytes) {
+        metadata = entry.data.u8;
+    } else if (entry.type == TYPE_INT32 && entry.count == nezha::dng::Layout::kMetadataBytes / 4) {
+        metadata = reinterpret_cast<const uint8_t*>(entry.data.i32);
+    }
+    nezha::dng::Layout layout;
+    const char* error = nezha::dng::parseLayout(metadata, metadata ? nezha::dng::Layout::kMetadataBytes : 0,
+            data, static_cast<size_t>(capacity), &layout);
+    if (error) {
+        ALOGE("Compressed DNG rejected: %s (metadata type=%u count=%zu capacity=%" PRId64 ")",
+                error, entry.type, entry.count, capacity);
+        jniThrowException(env, "java/lang/IllegalArgumentException", error);
+        return;
+    }
+    sp<TiffWriter> writer = DngCreator_setup(env, thiz, layout.width, layout.height, true);
+    if (!writer || env->ExceptionCheck()) return;
+
+    // Add complete placeholder entries before computing offsets. Replacing LONG
+    // values with the same count preserves the exact serialized header size.
+    auto add = [&](uint16_t id, size_t count, const auto* values, uint32_t ifd = TIFF_IFD_0) {
+        if (env->ExceptionCheck()) return false;
+        if (writer->addEntry(id, count, values, ifd) == OK) return true;
+        jniThrowExceptionFmt(env, "java/lang/IllegalStateException", "Cannot create DNG TIFF tag %u", id);
+        return false;
+    };
+    const uint16_t jpegCompression = 7;
+    if (!add(TAG_COMPRESSION, 1, &jpegCompression)) return;
+    const uint16_t offsetTag = layout.tiled ? NEZHA_TILE_OFFSETS : TAG_STRIPOFFSETS;
+    const uint16_t countTag = layout.tiled ? NEZHA_TILE_BYTE_COUNTS : TAG_STRIPBYTECOUNTS;
+    if (layout.tiled) {
+        if (!add(NEZHA_TILE_WIDTH, 1, &layout.tileWidth) || !add(NEZHA_TILE_LENGTH, 1, &layout.tileHeight)) return;
+    } else if (!add(TAG_ROWSPERSTRIP, 1, &layout.height)) {
+        return;
+    }
+    if (!add(offsetTag, layout.count, layout.offsets.data()) ||
+            !add(countTag, layout.count, layout.byteCounts.data())) return;
+
+    const uint32_t previewSize = context->jpegPreview.size();
+    uint32_t previewOffset = 0;
+    if (previewSize) {
+        if (writer->addSubIfd(TIFF_IFD_0, TIFF_IFD_SUB1) != OK) {
+            jniThrowException(env, "java/lang/IllegalStateException", "Cannot create DNG preview IFD");
+            return;
+        }
+        const uint32_t reducedImage = 1;
+        const uint16_t bits[] = {8, 8, 8};
+        const uint16_t samples = 3;
+        const uint16_t ycbcr = 6;
+        const uint16_t chunky = 1;
+        const uint16_t orientation = context->getOrientation();
+        if (!add(TAG_NEWSUBFILETYPE, 1, &reducedImage, TIFF_IFD_SUB1) ||
+                !add(TAG_IMAGEWIDTH, 1, &context->jpegWidth, TIFF_IFD_SUB1) ||
+                !add(TAG_IMAGELENGTH, 1, &context->jpegHeight, TIFF_IFD_SUB1) ||
+                !add(TAG_BITSPERSAMPLE, 3, bits, TIFF_IFD_SUB1) ||
+                !add(TAG_COMPRESSION, 1, &jpegCompression, TIFF_IFD_SUB1) ||
+                !add(TAG_PHOTOMETRICINTERPRETATION, 1, &ycbcr, TIFF_IFD_SUB1) ||
+                !add(TAG_SAMPLESPERPIXEL, 1, &samples, TIFF_IFD_SUB1) ||
+                !add(TAG_PLANARCONFIGURATION, 1, &chunky, TIFF_IFD_SUB1) ||
+                !add(TAG_ROWSPERSTRIP, 1, &context->jpegHeight, TIFF_IFD_SUB1) ||
+                !add(TAG_STRIPBYTECOUNTS, 1, &previewSize, TIFF_IFD_SUB1) ||
+                !add(TAG_STRIPOFFSETS, 1, &previewOffset, TIFF_IFD_SUB1)) return;
+        if (orientation != TAG_ORIENTATION_UNKNOWN &&
+                !add(TAG_ORIENTATION, 1, &orientation, TIFF_IFD_SUB1)) return;
+    }
+    const uint32_t headerSize = writer->getTotalSize();
+    if (!nezha::dng::assignOffsets(headerSize, previewSize, &layout, &previewOffset)) {
+        jniThrowException(env, "java/lang/IllegalArgumentException", "Compressed DNG exceeds TIFF offsets");
+        return;
+    }
+    if (!add(offsetTag, layout.count, layout.offsets.data()) ||
+            (previewSize && !add(TAG_STRIPOFFSETS, 1, &previewOffset, TIFF_IFD_SUB1))) return;
+    if (writer->getTotalSize() != headerSize) {
+        jniThrowException(env, "java/lang/IllegalStateException", "Compressed DNG header size changed");
+        return;
+    }
+    sp<JniOutputStream> out = new JniOutputStream(env, outStream);
+    if (env->ExceptionCheck()) return;
+    const uint8_t padding = 0;
+    status_t status = writer->write(out.get());
+    if (status == OK) status = out->write(data, 0, layout.dataSize);
+    if (status == OK && previewSize && ((headerSize + layout.dataSize) & 1)) {
+        status = out->write(&padding, 0, 1);
+    }
+    if (status == OK && previewSize) status = out->write(context->jpegPreview.array(), 0, previewSize);
+    if (status != OK || env->ExceptionCheck()) {
+        if (!env->ExceptionCheck()) jniThrowException(env, "java/io/IOException", "Compressed DNG write failed");
+        return;
+    }
+    ALOGI("Wrote compressed DNG %ux%u, %u lossless JPEG segment(s), %u image bytes, %u preview bytes",
+            layout.width, layout.height, layout.count, layout.dataSize, previewSize);
+}
