From: Nezha bring-up workspace <nezha@localhost>
Subject: [PATCH] releasetools: read partition properties from optional and ZIP trees

Keep the existing partition and property-file precedence. Target-files may omit
optional partitions, and documented callers also pass a ZIP path or open ZIP.
Recognize real directories in each input form and leave absent properties
absent. Do not synthesize partition trees, inspect images, or change signing.

Pinned project: build/make a438ca40c6ed779042f806142b1165ba1360a7b2

--- a/tools/releasetools/common.py
+++ b/tools/releasetools/common.py
@@ -1096,24 +1096,27 @@
       return ''
     with open(prop_file, "r") as f:
       return f.read()
 
   @staticmethod
   def _ReadPartitionPropFile(input_file, name):
     """
     Read build.prop for name from input_file.
     Return empty string if not found.
     """
     data = ''
     partition_map = PartitionMapFromTargetFiles(input_file)
+    if name not in partition_map:
+      logger.warning("Failed to find directory for partition %s", name)
+      return data
     for prop_file in ['{}/etc/build.prop'.format(partition_map[name]),
                       '{}/build.prop'.format(partition_map[name])]:
       try:
         data = ReadFromInputFile(input_file, prop_file)
         break
       except KeyError:
         logger.warning('Failed to read %s', prop_file)
     if data == '':
       logger.warning("Failed to read build.prop for partition {}".format(name))
     return data
 
