 def PartitionMapFromTargetFiles(target_files_dir):
-  """Builds a map from partition -> path within an extracted target files directory."""
+  """Maps partitions to paths in a target-files directory or ZIP input."""
+  # ZIP entries need not include explicit directory entries. Match the trailing
+  # slash so similarly named files and partitions do not become directories.
+  if isinstance(target_files_dir, zipfile.ZipFile):
+    archive_entries = target_files_dir.namelist()
+  elif zipfile.is_zipfile(target_files_dir):
+    with zipfile.ZipFile(target_files_dir, "r", allowZip64=True) as input_zip:
+      return PartitionMapFromTargetFiles(input_zip)
+  elif os.path.isdir(target_files_dir):
+    archive_entries = None
+  else:
+    raise ValueError("Expected a target-files directory or ZIP input: " +
+                     str(target_files_dir))
+
   # Keep possible_subdirs in sync with build/make/core/board_config.mk.
   possible_subdirs = {
       "system": ["SYSTEM"],
       "vendor": ["VENDOR", "SYSTEM/vendor"],
       "product": ["PRODUCT", "SYSTEM/product"],
       "system_ext": ["SYSTEM_EXT", "SYSTEM/system_ext"],
       "odm": ["ODM", "VENDOR/odm", "SYSTEM/vendor/odm"],
       "vendor_dlkm": [
           "VENDOR_DLKM", "VENDOR/vendor_dlkm", "SYSTEM/vendor/vendor_dlkm"
       ],
       "odm_dlkm": ["ODM_DLKM", "VENDOR/odm_dlkm", "SYSTEM/vendor/odm_dlkm"],
       "system_dlkm": ["SYSTEM_DLKM", "SYSTEM/system_dlkm"],
   }
   partition_map = {}
   for partition, subdirs in possible_subdirs.items():
     for subdir in subdirs:
-      if os.path.exists(os.path.join(target_files_dir, subdir)):
+      if archive_entries is None:
+        has_directory = os.path.isdir(os.path.join(target_files_dir, subdir))
+      else:
+        has_directory = any(entry.startswith(subdir + "/")
+                            for entry in archive_entries)
+      if has_directory:
         partition_map[partition] = subdir
         break
   return partition_map
 
 
