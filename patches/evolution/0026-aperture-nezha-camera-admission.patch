diff --git a/app/src/main/java/org/lineageos/aperture/compat/NezhaCameraFactory.java b/app/src/main/java/org/lineageos/aperture/compat/NezhaCameraFactory.java
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/org/lineageos/aperture/compat/NezhaCameraFactory.java
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package org.lineageos.aperture.compat;
+
+import android.annotation.SuppressLint;
+import android.hardware.camera2.CameraAccessException;
+import android.hardware.camera2.CameraCharacteristics;
+import android.hardware.camera2.CameraManager;
+import android.os.Build;
+import android.util.Log;
+import androidx.camera.core.CameraIdentifier;
+import androidx.camera.core.CameraUnavailableException;
+import androidx.camera.core.CameraXConfig;
+import androidx.camera.core.InitializationException;
+import androidx.camera.core.concurrent.CameraCoordinator;
+import androidx.camera.core.impl.CameraFactory;
+import androidx.camera.core.impl.CameraInternal;
+import androidx.camera.core.impl.Observable;
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+
+/** Excludes Nezha processing-only devices before CameraX builds any stream maps. */
+@SuppressLint("RestrictedApi")
+public final class NezhaCameraFactory implements CameraFactory, CameraFactory.Interrogator {
+    private static final String TAG = "NezhaCameraFactory";
+    private final CameraFactory delegate;
+    private final CameraManager manager;
+
+    public static CameraXConfig configure(CameraXConfig base) {
+        if (!"nezha".equals(Build.DEVICE)) return base;
+        CameraFactory.Provider provider = base.getCameraFactoryProvider(null);
+        if (provider == null) throw new IllegalStateException("Camera2 factory provider is missing");
+        return CameraXConfig.Builder.fromConfig(base).setCameraFactoryProvider(
+                (context, threads, limiter, timeout, config, calculator) -> {
+                    CameraFactory factory = provider.newInstance(
+                            context, threads, limiter, timeout, config, calculator);
+                    try {
+                        return new NezhaCameraFactory(factory,
+                                context.getSystemService(CameraManager.class));
+                    } catch (InitializationException | RuntimeException error) {
+                        factory.shutdown();
+                        throw error;
+                    }
+                }).build();
+    }
+
+    NezhaCameraFactory(CameraFactory delegate, CameraManager manager) throws InitializationException {
+        this.delegate = delegate;
+        this.manager = manager;
+        // Also update the delegate's coordinator before surface-manager construction.
+        onCameraIdsUpdated(new ArrayList<>(delegate.getAvailableCameraIds()));
+    }
+
+    static boolean admits(int[] capabilities) {
+        if (capabilities == null) return false;
+        boolean backwardCompatible = false;
+        for (int capability : capabilities) {
+            if (capability == CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES_SYSTEM_CAMERA) {
+                return false;
+            }
+            if (capability == CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES_BACKWARD_COMPATIBLE) {
+                backwardCompatible = true;
+            }
+        }
+        return backwardCompatible;
+    }
+
+    private List<String> filter(List<String> ids) {
+        List<String> result = new ArrayList<>();
+        for (String id : ids) {
+            try {
+                int[] capabilities = manager.getCameraCharacteristics(id).get(
+                        CameraCharacteristics.REQUEST_AVAILABLE_CAPABILITIES);
+                if (admits(capabilities)) {
+                    result.add(id);
+                } else {
+                    Log.i(TAG, "Excluding processing-only camera " + id);
+                }
+            } catch (CameraAccessException | RuntimeException error) {
+                Log.w(TAG, "Cannot read capabilities for camera " + id, error);
+            }
+        }
+        return result;
+    }
+
+    @Override public Set<String> getAvailableCameraIds() {
+        return new LinkedHashSet<>(filter(new ArrayList<>(delegate.getAvailableCameraIds())));
+    }
+
+    @Override public List<String> getAvailableCameraIds(List<String> ids) {
+        List<String> filtered = filter(ids);
+        if (delegate instanceof CameraFactory.Interrogator) {
+            return ((CameraFactory.Interrogator) delegate).getAvailableCameraIds(filtered);
+        }
+        return filtered;
+    }
+
+    @Override public void onCameraIdsUpdated(List<String> ids) throws InitializationException {
+        delegate.onCameraIdsUpdated(filter(ids));
+    }
+
+    @Override public CameraInternal getCamera(String id) throws CameraUnavailableException {
+        if (!getAvailableCameraIds().contains(id)) {
+            throw new CameraUnavailableException(CameraUnavailableException.CAMERA_ERROR,
+                    "Camera " + id + " is not a public backward-compatible camera");
+        }
+        return delegate.getCamera(id);
+    }
+
+    @Override public CameraCoordinator getCameraCoordinator() { return delegate.getCameraCoordinator(); }
+    @Override public Object getCameraManager() { return delegate.getCameraManager(); }
+    @Override public Observable<List<CameraIdentifier>> getCameraPresenceSource() {
+        return delegate.getCameraPresenceSource();
+    }
+    @Override public void shutdown() { delegate.shutdown(); }
+}
