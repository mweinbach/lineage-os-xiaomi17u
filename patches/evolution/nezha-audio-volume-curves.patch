diff --git a/frameworks/av/services/audiopolicy/engine/common/src/EngineBase.cpp b/frameworks/av/services/audiopolicy/engine/common/src/EngineBase.cpp
--- a/frameworks/av/services/audiopolicy/engine/common/src/EngineBase.cpp
+++ b/frameworks/av/services/audiopolicy/engine/common/src/EngineBase.cpp
@@ -148,6 +148,18 @@
         // It is allowed for the HAL to return an empty list of strategies.
         if (result.parsedConfig->productStrategies.empty()) {
             result.parsedConfig->productStrategies = gDefaultEngineConfig.productStrategies;
+        }
+    }
+    // A configuration with no volume groups is not usable: processParsingResult() gives every
+    // group an empty curve set, and a group with no curve for the device reports 0 dB, i.e. full
+    // scale at every index, so the volume control does nothing. Fill them from the legacy volume
+    // tables, exactly as the XML path does when it finds no engine configuration at all.
+    if (result.parsedConfig->volumeGroups.empty()) {
+        ALOGW("%s: no volume groups in the HAL configuration, using the legacy volume tables",
+              __func__);
+        if (engineConfig::parseLegacyVolumes(result.parsedConfig->volumeGroups) != NO_ERROR) {
+            ALOGE("%s: no legacy volume tables either, using the default music group", __func__);
+            result.parsedConfig->volumeGroups = gDefaultVolumeGroups;
         }
     }
     return processParsingResult(std::move(result));
