+def _NezhaCareMapPropertyBytes(relative):
+  """Read a bounded ordinary property file and retain its filesystem identity."""
+  path = _NezhaCareMapPath(relative)
+  descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+  try:
+    before = os.fstat(descriptor)
+    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
+      raise ExternalError('Non-regular or aliased Nezha ODM property: ' + relative)
+    if not 0 < before.st_size <= 1024 * 1024:
+      raise ExternalError('Invalid Nezha ODM property size: ' + relative)
+    with os.fdopen(descriptor, 'rb', closefd=False) as stream:
+      raw = stream.read(1024 * 1024 + 1)
+    states = {tuple(getattr(value, key) for key in
+                    ('st_dev', 'st_ino', 'st_mode', 'st_nlink', 'st_size',
+                     'st_mtime_ns', 'st_ctime_ns'))
+              for value in (before, os.fstat(descriptor), os.lstat(path))}
+    if (len(states) != 1 or len(raw) != before.st_size or
+        _NezhaCareMapPath(relative) != path):
+      raise ExternalError('Nezha ODM property changed while reading: ' + relative)
+    return raw, next(iter(states))
+  finally:
+    os.close(descriptor)
+
+
+def _NezhaCareMapOdmStatements(raw, relative):
+  """Inspect the exact captured import grammar, using native init LF lines.
+
+  This is intentionally not a general property interpreter. Permission checks
+  cannot create a SYSTEM fingerprint when no captured statement assigns one.
+  Native init ignores the one bare factory key because it has no '='.
+  """
+  if any(byte < 32 and byte not in (9, 10) for byte in raw):
+    raise ExternalError('Invalid Nezha ODM property text: ' + relative)
+  try:
+    text = raw.decode('utf-8')
+  except UnicodeError as error:
+    raise ExternalError('Invalid Nezha ODM property encoding: ' + relative) from error
+  imports = []
+  ignored = []
+  expected = (
+      (32, 'import /odm/etc/${ro.boot.product.hardware.sku}_${ro.boot.ptcountrycode}_build.prop'),
+      (33, 'import /odm/etc/${ro.boot.product.hardware.sku}_${ro.boot.hwversion}.prop'))
+  for number, line in enumerate(text.split('\n'), 1):
+    line = line.strip(' \t')
+    if not line or line.startswith('#'):
+      continue
+    if line.startswith('import'):
+      imports.append((number, line))
+    elif '=' not in line:
+      ignored.append((number, line))
+    elif line.split('=', 1)[0].strip(' \t') == 'ro.system.build.fingerprint':
+      raise ExternalError('Imported Nezha ODM SYSTEM fingerprint: ' + relative)
+  if relative == 'ODM/etc/build.prop':
+    if imports != list(expected) or ignored != [(480, 'ro.vendor.mitee_support')]:
+      raise ExternalError('Nezha ODM importer grammar differs from the original')
+  elif imports or ignored:
+    raise ExternalError('Unqualified nested Nezha ODM property statement: ' + relative)
+  return [line for _, line in imports + ignored]
+
+
+def _NezhaCareMapOdmImports():
+  """Qualify all captured candidates and resolve explicitly supplied selectors.
+
+  The caller supplies declarations, not proof of live boot-property values.
+  Final image/selector/init provenance and runtime equality remain separate
+  gates. Expansion reads global properties in init, not this file's property
+  map; never infer selector values from assignments or captured filenames.
+  """
+  names = {
+      'sku': 'ro.boot.product.hardware.sku',
+      'country': 'ro.boot.ptcountrycode',
+      'hwversion': 'ro.boot.hwversion'}
+  prefix = 'nezha_care_map_odm_import_'
+  info = OPTIONS.info_dict
+  if {key for key in info if key.startswith(prefix)} != {prefix + key for key in names}:
+    raise ExternalError('Nezha ODM imports require exactly three declared boot selectors')
+  selectors = {}
+  allowed = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-'
+  for key, property_name in names.items():
+    value = info[prefix + key]
+    if (not isinstance(value, str) or not 1 <= len(value) <= 92 or
+        value in ('.', '..', 'unknown') or value[0] not in allowed[:62] or
+        any(char not in allowed for char in value)):
+      raise ExternalError('Unsafe or empty Nezha ODM boot selector: ' + property_name)
+    selectors[property_name] = value
+  if selectors[names['sku']] != 'nezha':
+    raise ExternalError('Unqualified Nezha ODM hardware SKU')
+
+  # This table is the complete direct /etc/*.prop projection of the pinned
+  # original ODM inventory: one importer and 21 leaf files, with no links.
+  # Require every candidate, even when today's declared selector picks another.
+  inputs = {}
+  allowed_statements = None
+  for relative, size, digest in _NEZHA_CARE_MAP_ODM_PROPERTIES:
+    raw, state = _NezhaCareMapPropertyBytes(relative)
+    if len(raw) != size or hashlib.sha256(raw).hexdigest() != digest:
+      raise ExternalError('Nezha ODM property differs from its captured original: ' + relative)
+    statements = _NezhaCareMapOdmStatements(raw, relative)
+    if relative == 'ODM/etc/build.prop':
+      allowed_statements = statements
+    inputs[relative] = {'sha256': digest, 'size_bytes': size, 'state': state}
+  if len(inputs) != 22 or len({value['state'][:2] for value in inputs.values()}) != 22:
+    raise ExternalError('Incomplete or aliased Nezha ODM property closure')
+  directory = os.path.dirname(_NezhaCareMapPath('ODM/etc/build.prop'))
+  actual = {'ODM/etc/' + name for name in os.listdir(directory) if name.endswith('.prop')}
+  if actual != set(inputs):
+    raise ExternalError('Nezha ODM property directory differs from its complete captured closure')
+
+  # These exact unfiltered templates use braced GetProperty substitutions.
+  # Native ExpandProps appends values verbatim; it does not recursively expand
+  # substituted '$' or turn substituted whitespace into an import filter.
+  paths = (
+      '/odm/etc/' + selectors[names['sku']] + '_' + selectors[names['country']] + '_build.prop',
+      '/odm/etc/' + selectors[names['sku']] + '_' + selectors[names['hwversion']] + '.prop')
+  imports = []
+  for runtime_path in paths:
+    relative = 'ODM' + runtime_path[len('/odm'):]
+    present = _NezhaCareMapPath(relative, required=False)
+    if relative in inputs:
+      if present is None:
+        raise ExternalError('Missing selected Nezha ODM import: ' + relative)
+      outcome = 'captured-file'
+    else:
+      # A single-component selector cannot escape /odm/etc. The complete
+      # original inventory has no other .prop basename, and the target-files
+      # directory must agree. This is explicit native missing-file behavior,
+      # not successful loading or a blanket permission to skip an import.
+      if present is not None:
+        raise ExternalError('Unqualified selected Nezha ODM import: ' + relative)
+      outcome = 'inventory-proven-absent'
+    imports.append({'path': runtime_path, 'outcome': outcome})
+    logger.info('Nezha declared ODM import %s: %s', runtime_path, outcome)
+  return {'selectors': selectors, 'inputs': inputs,
+          'allowed_statements': allowed_statements, 'imports': imports}
+
