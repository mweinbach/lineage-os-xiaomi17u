+def _NezhaCareMapRecheckOdmImports(closure):
+  """Recheck original bytes and declarations before accepting the marker."""
+  current = _NezhaCareMapOdmImports()
+  if current != closure:
+    raise ExternalError('Nezha ODM property closure changed while selecting the marker')
