+def _CheckNezhaCareMapCoverage(entries, mi_ext_entry):
+  """Do not call a partial or unknown text input a complete selected care map."""
+  rows = [entries[index:index + 4] for index in range(0, len(entries), 4)]
+  names = [row[0] for row in rows]
+  required = {'system', 'system_ext', 'system_dlkm', 'vendor', 'vendor_dlkm',
+              'odm', 'product', 'mi_ext'}
+  if (len(entries) % 4 or len(names) != len(set(names)) or set(names) != required or
+      any(not value or value == 'unknown' or '\n' in value or '\r' in value
+          for row in rows for value in row)):
+    raise ExternalError('Incomplete or ambiguous required Nezha care-map entries')
+  for row in rows:
+    try:
+      ranges = rangelib.RangeSet.parse_raw(row[1])
+      if (not ranges or not ranges.monotonic or ranges.data[0] < 0 or
+          ranges.to_string_raw() != row[1]):
+        raise ValueError('empty, unordered or noncanonical range')
+    except (ValueError, AssertionError) as error:
+      raise ExternalError('Invalid required Nezha care-map range: ' + row[0]) from error
+  system = next(row for row in rows if row[0] == 'system')
+  if system[2:] != mi_ext_entry[2:]:
+    raise ExternalError('Nezha mi_ext must share the genuine SYSTEM freshness pair')
+
