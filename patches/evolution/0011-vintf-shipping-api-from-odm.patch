+        int(value) > (1 << 64) - 1):
+      raise ValueError('Invalid {} in {}.build.prop: {!r}'.format(
+          property_name, partition, value))
+    levels[partition] = value
+  if not levels:
+    raise ValueError('Cannot determine {} from vendor or ODM properties'.format(
+        property_name))
+  if len(set(levels.values())) != 1:
+    raise ValueError('Conflicting {} in vendor and ODM properties: {}'.format(
+        property_name, levels))
+  shipping_api_level = levels.get('vendor', levels.get('odm'))
+  return ['--property', property_name + '=' + shipping_api_level]
 
 
