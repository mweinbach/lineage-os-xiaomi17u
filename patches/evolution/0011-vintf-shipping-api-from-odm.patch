+  # Init loads ODM properties after vendor properties. Keep both original
+  # sources visible and reject a disagreement instead of guessing precedence.
+  property_name = 'ro.product.first_api_level'
+  levels = {}
+  for partition in ('vendor', 'odm'):
+    props = info_dict.get(partition + '.build.prop')
+    value = props.GetProp(property_name) if props is not None else None
+    if value is None:
+      continue
+    # PropertyFetcher uses uint64_t. Require canonical positive decimal text
+    # so malformed metadata cannot silently become its native default value.
+    if (not isinstance(value, str) or not 1 <= len(value) <= 20 or
