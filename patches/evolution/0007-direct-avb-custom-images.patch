+# Copy and verify prebuilt direct-descriptor images without changing their AVB
+# footer, tree, FEC, filesystem, or embedded key. Root vbmeta signs the descriptor.
+# $(1): prebuilt. $(2): partition. $(3): installed image.
+define copy_direct_custom_image
+$(3): $(1) $(AVBTOOL) $(INTERNAL_USERIMAGES_DEPS)
+	@echo Target direct AVB custom image: $(3)
+	@test "$$$$(sha256sum < $(1) | cut -d ' ' -f 1)" = "$(BOARD_$(call to-upper,$(2))_IMAGE_SHA256)"
+	mkdir -p $(dir $(3))
+	cp $(1) $(3)
+	@test "$$$$(sha256sum < $(3) | cut -d ' ' -f 1)" = "$(BOARD_$(call to-upper,$(2))_IMAGE_SHA256)"
+	PATH=$(INTERNAL_USERIMAGES_BINARY_PATHS):$$$$PATH $(AVBTOOL) verify_image --image $(3)
+INSTALLED_CUSTOMIMAGES_TARGET += $(3)
+INSTALLED_$(call to-upper,$(2))IMAGE_TARGET := $(3)
+.PHONY: $(2)image
+$(2)image: $(3)
+endef
+$(foreach partition,$(BOARD_AVB_CUSTOMIMAGES_DIRECT_PARTITION_LIST), \
+  $(eval $(call copy_direct_custom_image,$(BOARD_$(call to-upper,$(partition))_IMAGE_LIST),$(partition),$(PRODUCT_OUT)/$(partition).img)))
+
 # Add AVB custom image to droid target
-$(foreach partition,$(BOARD_AVB_CUSTOMIMAGES_PARTITION_LIST), \
