+ifdef TARGET_PREBUILT_RECOVERY
+# Never rebuild, re-sign or add a footer to the externally verified image.
+# $(1): input image; $(2): installed image or target-files BOOTABLE_IMAGES image.
+define copy-verified-prebuilt-recovery
+  $(hide) set -eu; \
+    recovery_src="$(1)"; recovery_dst="$(2)"; \
+    recovery_sha="$(TARGET_PREBUILT_RECOVERY_SHA256)"; \
+    recovery_size="$(BOARD_RECOVERYIMAGE_PARTITION_SIZE)"; \
+    test "$${#recovery_sha}" -eq 64; \
+    case "$$recovery_sha" in *[!0-9a-f]*) exit 1;; esac; \
+    case "$$recovery_size" in ''|*[!0-9]*) exit 1;; esac; \
+    test "$$recovery_size" -gt 0; \
+    test -f "$$recovery_src"; test ! -L "$$recovery_src"; \
+    test ! -L "$$recovery_dst"; test ! -d "$$recovery_dst"; \
+    test "$$(wc -c < "$$recovery_src")" -eq "$$recovery_size"; \
+    test "$$(sha256sum < "$$recovery_src" | cut -d ' ' -f 1)" = "$$recovery_sha"; \
+    mkdir -p "$$(dirname "$$recovery_dst")"; \
+    recovery_tmp="$$(mktemp "$$recovery_dst.tmp.XXXXXX")"; \
+    trap 'rm -f "$$recovery_tmp"' EXIT; \
+    cp -f "$$recovery_src" "$$recovery_tmp"; \
+    test "$$(wc -c < "$$recovery_tmp")" -eq "$$recovery_size"; \
+    test "$$(sha256sum < "$$recovery_tmp" | cut -d ' ' -f 1)" = "$$recovery_sha"; \
+    mv -f "$$recovery_tmp" "$$recovery_dst"; \
+    test "$$(wc -c < "$$recovery_dst")" -eq "$$recovery_size"; \
+    test "$$(sha256sum < "$$recovery_dst" | cut -d ' ' -f 1)" = "$$recovery_sha"
+endef
+
+recoveryimage-deps := $(TARGET_PREBUILT_RECOVERY)
+# Keep the real image free of phony prerequisites for Kati.
+$(INSTALLED_RECOVERYIMAGE_TARGET): $(recoveryimage-deps)
+	$(call copy-verified-prebuilt-recovery,$(TARGET_PREBUILT_RECOVERY),$@)
+else
 ifndef BOARD_CUSTOM_BOOTIMG_MK
 $(INSTALLED_RECOVERYIMAGE_TARGET): $(recoveryimage-deps)
 	$(call build-recoveryimage-target, $@, \
@@ -2859,6 +2920,7 @@
