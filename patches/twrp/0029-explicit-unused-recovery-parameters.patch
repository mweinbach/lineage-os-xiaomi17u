 using namespace std;
 
 twrpTar::twrpTar(void) {
 	use_encryption = 0;
 	userdata_encryption = 0;
 	use_compression = 0;
 	split_archives = 0;
 	pigz_pid = 0;
 	oaes_pid = 0;
 	Total_Backup_Size = 0;
 	Archive_Current_Size = 0;
 	include_root_dir = true;
 	tar_type.openfunc = open;
 	tar_type.closefunc = close;
 	tar_type.readfunc = read;
 	input_fd = -1;
 	output_fd = -1;
 	backup_exclusions = NULL;
 
 #ifdef USE_FSCRYPT
 	fscrypt_set_mode();
 #endif
 }
 
 twrpTar::~twrpTar(void) {
 	// Do nothing
 }
 
