// Offline public candidate for device/xiaomi/nezha/ims/Android.bp.
// Not installed in the Android source or selected. Private bytes stay in vendor.
// Original IMS SHA256: 56f103215b1aa301e65b6ecde29bb67318cba07f3f3d91d2196372fd14d44172
// Default candidate preserves the original verified Xiaomi-signed bytes.
// No derivative, signing key, OEM API implementation or policy is fabricated here.
// The consolidated native fragment supplies the sole public Soong namespace.

android_app_import {
    name: "ims",
    enabled: false,
    owner: "xiaomi",
    apk: "//vendor/xiaomi/nezha-ims:nezha_ims_apk_input",
    presigned: true,
    preprocessed: true,
    privileged: true,
    system_ext_specific: true,
    enforce_uses_libs: true,
    uses_libs: [
        "qti-telephony-hidl-wrapper",
        "qti-telephony-utils",
        "ims-ext-common",
    ],
    optional_uses_libs: [],
    required: [
        "nezha_ims_privapp_permissions",
        "nezha_ims_qti_permission_groups",
        "nezha_ims_libimscamera_jni_app_link",
        "nezha_ims_libimsmedia_jni_app_link",
        "nezha_ims_lib_imsvt",
    ],
}

prebuilt_etc_xml {
    name: "nezha_ims_privapp_permissions",
    enabled: false,
    src: "permissions/privapp-permissions-org.codeaurora.ims.xml",
    sub_dir: "permissions",
    filename: "privapp-permissions-org.codeaurora.ims.xml",
    system_ext_specific: true,
}

// Preserve the exact factory DIAG and AUDIO supplementary-group contract only
// after native/DAC review and target group-name resolution. No extra GIDs.
prebuilt_etc_xml {
    name: "nezha_ims_qti_permission_groups",
    enabled: false,
    src: "permissions/qti_permissions.xml",
    sub_dir: "permissions",
    filename: "qti_permissions.xml",
    system_ext_specific: true,
}
