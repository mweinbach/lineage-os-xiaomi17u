// INACTIVE CANDIDATE: compose into device/xiaomi/nezha/ims only after the
// complete IMS API, privilege, policy and native component review passes.
// These are original DEX JARs, not JVM .class JARs. Preserve the already
// reviewed dex-import-uses-library.patch. No .odex/.vdex is imported.
// No product selection is emitted; modules are deliberately disabled.

dex_import {
    name: "qti-telephony-hidl-wrapper",
    enabled: false,
    jars: ["//vendor/xiaomi/nezha-ims:nezha_ims_qti_telephony_hidl_wrapper_jar"],
    system_ext_specific: true,
    required: ["nezha_ims_qti_telephony_hidl_wrapper_xml"],
    // XML declares no transitive required libraries. Do not invent uses_libs.
}

prebuilt_etc {
    name: "nezha_ims_qti_telephony_hidl_wrapper_xml",
    enabled: false,
    src: "//vendor/xiaomi/nezha-ims:nezha_ims_qti_telephony_hidl_wrapper_xml",
    filename: "qti_telephony_hidl_wrapper.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

dex_import {
    name: "qti-telephony-utils",
    enabled: false,
    jars: ["//vendor/xiaomi/nezha-ims:nezha_ims_qti_telephony_utils_jar"],
    system_ext_specific: true,
    required: ["nezha_ims_qti_telephony_utils_xml"],
    // XML declares no transitive required libraries. Do not invent uses_libs.
}

prebuilt_etc {
    name: "nezha_ims_qti_telephony_utils_xml",
    enabled: false,
    src: "//vendor/xiaomi/nezha-ims:nezha_ims_qti_telephony_utils_xml",
    filename: "qti_telephony_utils.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
