  "other_findings": [
    {
      "id": "cellular-registration",
      "observation": "Three modem-reported searches recover in 16.220, 19.129 and 19.033 seconds, roughly 12 minutes apart. A separate 20:21:28 event reports MS_IDENTITY_CANNOT_BE_DERIVED_BY_NETWORK and PLMN_NOT_ALLOWED; registration recovers by 20:21:29.983.",
      "cause": "unresolved carrier/modem registration behavior; not proven caused by the QMI or WLAN binding errors",
      "next": "Verify IMS registration after the capability fix, then capture modem reject/data reasons if it persists.",
      "extra_code_mapping": {
        "4001": "packet service attached",
        "4002": "packet service not attached"
      },
      "extra_code_context": "Factory IMS emits these on service-domain changes while IMS is already deregistered; they are not a root-cause diagnosis.",
      "data_detach": "20:21:28.119 modem unsolicited EMM_DETACHED; normal data setup succeeds at 20:21:31.258. No radio-power, network-selection, allowed-network-type or data-deactivation request appears in the retained RILJ lines."
    },
    {
      "id": "settings-audio-denial",
      "observation": "Settings sent Binder transaction 1599295570, which local IBinder defines as SYSPROPS_TRANSACTION (_SPR). SystemPropPoker broadcasts it to services from a background AsyncTask and ignores RemoteException.",
      "classification": "consistent with a developer-settings property-refresh broadcast; does not establish a playback failure",
      "policy_changed": false
    },
    {
      "id": "radio-reporting",
      "observation": "The analytics subscription lookup catches NullPointerException and returns INVALID_SUB_ID; the AIDL physical-channel parser logs unknown band data and continues without setting the band.",
      "feature_failure_established": false,
      "source_changed": false
    }
  ],
