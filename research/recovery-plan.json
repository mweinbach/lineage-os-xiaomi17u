  "requirements": {
    "boot_and_modules": [
      "Use separate header-v4 recovery ramdisk; do not move it to vendor_boot or insert an unverified kernel.",
      "Keep exact Nezha DTBs/DTBO, 4 KiB kernel and complete recovery module dependency closure.",
      "Keep vendor and GKI zram/zsmalloc pairs distinct and follow the recorded per-stage selector.",
      "Confirm bootloader slot, boot/vendor_boot/init_boot dependencies and size limits from package metadata plus later authorized live checks."
    ],
    "storage_and_encryption": [
      "Derive recovery fstab from the new factory set; confirm its filesystem and encryption formats against the earlier F2FS/wrapped-key baseline, and preserve AVB and logical/slot flags.",
      "Verify KeyMint, Gatekeeper, Weaver, secure-element route, TEE/firmware and wrapped-key interfaces for this actual variant.",
      "Preserve real OS/vendor/boot patch levels; never use future dates or fake version strings.",
      "Keep automatic decryption, automatic formatting, snapshot mutations and key-blob write-back out of initial tests.",
      "Validate wrong credentials fail without key migration or fallback that weakens authentication; never request credentials in logs or source."
    ],
    "safety_controls": [
      "Keep SELinux enforcing and neverallow checks enabled.",
      "Keep VINTF, ELF, signature, AVB and rollback checks enabled.",
      "Keep critical bootloader, GPT, firmware and persistent-security partitions outside initial write support.",
      "Do not use another model's firmware, geometry, crypto route, policy or AVB chain.",
      "Do not assume a recovery backup can restore hardware-backed state or that a spare slot is independently bootable."
    ],
    "backups": [
      "Test backup scope and restore behavior separately; a successful UI boot is not a proven recovery path.",
      "Keep copies off-device and verify hashes.",
      "Include internal media in a separate backup plan; ordinary TWRP data backups exclude /data/media.",
      "Preserve same-device, same-version metadata and hardware-backed credential dependencies; do not copy another phone's persistent identity or keys."
    ],
    "virtual_ab": [
      "Observe snapshot and merge state before any later authorized modification.",
      "Do not present Virtual A/B as two independent complete super partitions.",
      "Validate recovery, boot-control HAL, userspace fastboot and snapshot handling against the chosen platform; do not auto-merge or alter active slots in a smoke test."
    ]
  },
